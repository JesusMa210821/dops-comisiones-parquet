# Copia este archivo a .env (no se versiona) y completa los valores.
# En Jenkins estos valores vienen de "Credentials", no de este archivo.

# PostgreSQL de clase (usuario de solo lectura; los datos los da el material del curso)
PG_HOST=<host_postgres>
PG_PORT=5432
PG_DB=dmc
PG_USER=<usuario_solo_lectura>
PG_PASSWORD=<contraseña>

# Cadena de conexión de la storage account del entorno (Access keys en el portal de Azure)
AZURE_STORAGE_CONNECTION_STRING=<connection_string>

# Opcional: periodo a procesar (por defecto el de config/<entorno>.json)
PERIODO=202610
