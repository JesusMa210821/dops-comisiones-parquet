{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "descripcion": "Data Lake (ADLS Gen2) del pipeline de comisiones: contenedor raw (CSV de entrada) y curated (Parquet de salida)."
  },
  "parameters": {
    "entorno": {
      "type": "string",
      "allowedValues": ["dev", "qa", "prd"],
      "metadata": { "description": "Entorno a desplegar" }
    },
    "prefijo": {
      "type": "string",
      "defaultValue": "dops",
      "maxLength": 8,
      "metadata": { "description": "Prefijo corto en minúsculas (p. ej. tus iniciales)" }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "sku": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": ["Standard_LRS", "Standard_ZRS", "Standard_GRS"]
    }
  },
  "variables": {
    "storageName": "[toLower(concat(parameters('prefijo'), parameters('entorno'), 'dls', substring(uniqueString(resourceGroup().id), 0, 6)))]",
    "contenedores": ["raw", "curated"],
    "tags": {
      "proyecto": "dataops-comisiones",
      "entorno": "[parameters('entorno')]",
      "gestionado-por": "jenkins-arm"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-01-01",
      "name": "[variables('storageName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": { "name": "[parameters('sku')]" },
      "kind": "StorageV2",
      "properties": {
        "isHnsEnabled": true,
        "accessTier": "Hot",
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/blobServices/containers",
      "apiVersion": "2023-01-01",
      "name": "[concat(variables('storageName'), '/default/', variables('contenedores')[copyIndex()])]",
      "copy": { "name": "contenedoresLoop", "count": "[length(variables('contenedores'))]" },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))]"
      ],
      "properties": { "publicAccess": "None" }
    }
  ],
  "outputs": {
    "storageAccountName": {
      "type": "string",
      "value": "[variables('storageName')]"
    },
    "dfsEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Storage/storageAccounts', variables('storageName'))).primaryEndpoints.dfs]"
    }
  }
}
